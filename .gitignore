.venv/
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.pytest_cache/

# artes geradas — pesadas, e sempre reproduzíveis a partir do project.yaml
projects/*/output/*
!projects/*/output/.gitkeep

# ...menos o magalenha, que NAO e' reproduzivel: a foto de referencia se perdeu
# (ver "Estado" no CLAUDE.md) e o motor nao roda mais pra ele. Este PNG e' o
# unico sobrevivente do render original, e e' dele que o build_instagram.py
# tira as pecas de divulgacao. Se ele sumir, o magalenha sai da colecao.
!projects/magalenha/output/*150dpi.png

# landing page (site/) — instalado via npm, buildado via vite
site/node_modules/
site/dist/
site/.vite/

# credenciais locais — NUNCA sobe pro GitHub
.claude.env
*.env
.env*
!.env.example

# fontes da identidade convertidas de woff2 (reproduzivel: social_kit.py)
scripts/.fontcache/

# carrosseis de Instagram — derivados do export, mesma regra de projects/output.
# social/marca/ FICA no git: e a marca, e e' o que se anexa num e-mail sem
# precisar rodar nada.
social/*
!social/marca/
